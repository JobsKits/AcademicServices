page{background:#f6f7f3;color:#182f2b;font-family:system-ui,sans-serif;font-size:30rpx}.page{max-width:1000rpx;margin:auto;padding:36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:24rpx;color:#47645b;letter-spacing:4rpx}.hero{font-size:66rpx;font-weight:650;line-height:1.18;margin:28rpx 0}.sub{color:#53665f;font-size:28rpx;line-height:1.7}.card{background:#fff;border:1rpx solid #dbe2db;border-radius:26rpx;padding:32rpx;margin:28rpx 0}.title{font-size:36rpx;font-weight:600}.number{color:#406f60;font-size:24rpx;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;flex-wrap:wrap}.badge{font-size:24rpx;color:#2d5a4a;background:#e4eee5;padding:8rpx 14rpx;border-radius:16rpx}.demo{background:#fff1cc;color:#594516;padding:20rpx;border-radius:16rpx;margin:20rpx 0;font-size:26rpx}button{background:#1e5545;color:white;border-radius:16rpx;font-size:28rpx;margin-top:24rpx}button.secondary{background:#e7ede6;color:#244b3e}button::after{border:0}label{display:block;font-size:26rpx;color:#425c50;margin-top:30rpx}input,textarea,picker{box-sizing:border-box;width:100%;border:1rpx solid #bac9bd;border-radius:14rpx;background:#fff;padding:22rpx;margin:12rpx 0;font-size:30rpx;color:#172f28}textarea{min-height:200rpx}.empty{text-align:center;padding:50rpx 20rpx}.muted{color:#53665f;font-size:26rpx}.section{font-size:32rpx;font-weight:600;margin-top:34rpx}.error{color:#9b2e24;background:#fff0ec;padding:20rpx;margin:20rpx 0;border-radius:14rpx}.line{white-space:pre-wrap;line-height:1.65;margin:14rpx 0;overflow-wrap:anywhere}.small{font-size:24rpx}.link{color:#185b45;text-decoration:underline}.gap{height:20rpx}

