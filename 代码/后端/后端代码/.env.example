APP_ENV=production
LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=./data
ADMIN_STATIC_DIR=./admin-web
CLIENT_STATIC_DIR=./client-web
# Set two distinct passwords of at least 12 characters. Do not use demo defaults.
ADMIN_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
# Empty means single-instance local JSON persistence. PostgreSQL enables row-locked aggregate persistence.
DATABASE_URL=
# Same origin works without this. Multiple explicit origins separated with commas. Production HTTPS only.
CORS_ORIGINS=
# mock confirms a simulated payment without charging. real is reserved and rejects payment until a verified channel is implemented.
PAYMENT_MODE=mock
# Explicitly 1 only for a demo deployment: admin/1234, auto-entry admin UI and forced mock. Formal server deployments use 0.
DEMO_MODE=0

# Email verification. Formal deployments require a real SMTP provider; unavailable SMTP returns 503.
# Never commit actual passwords. Only explicit Demo without SMTP returns a visible demo_code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) or implicit (usually 465); certificate verification is mandatory.
SMTP_TLS_MODE=starttls
