    },
    "after_sale": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "close_after_sale": {
      "role": "admin",
      "fields": [
        "after_sale_id",
        "text"
      ]
    },
    "message": {
      "role": "both",
      "fields": [
        "text"
      ]
    },
    "withdraw_request": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "approve_refund": {
      "role": "admin",
      "fields": [
        "refund_id"
      ]
    },
    "confirm_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "reference"
      ]
    },
    "mark_refund_unknown": {
      "role": "admin",
      "fields": [
        "refund_id"
      ]
    },
    "fail_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "text"
      ]
    },
    "reject_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "text"
      ]
    },
    "resolve_refund_failed": {
      "role": "admin",
      "fields": [
        "refund_id",
        "reference",
        "text"
      ]
    },
    "reject_cancel": {
      "role": "customer",
      "fields": []
    },
    "propose_change": {
