      "fields": [
        "change_id"
      ]
    }
  },
  "error_shape": {
    "error": {
      "code": "version_conflict",
      "message": "请刷新后重试"
    }
  },
  "operation": {
    "method": "GET",
    "path": "/operations/{key}",
    "response": {
      "operation": {
        "status": "succeeded",
        "case_id": "UUID",
        "action": "message",
        "created_at": "RFC3339"
      },
      "case": "latest Case"
    },
    "note": "404 means no committed receipt now, not proof an in-flight write failed"
  },
  "detail": {
    "method": "GET",
    "path": "/cases/{id}",
    "response": {
      "case": "Case object"
    }
  },
