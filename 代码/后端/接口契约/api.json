        "name": "客户",
        "role": "customer",
        "avatar_url": ""
      },
      "services": [],
      "cases": []
    }
  },
  "create_case": {
    "method": "POST",
    "path": "/cases",
    "body": {
      "service_id": "graduation",
      "title": "示例需求",
      "description": "说明目标和现有材料",
      "discipline": "专业",
      "level": "本科",
      "word_count": 5000,
      "language": "中文",
      "deadline": "2026-12-01",
      "contact": "联系说明",
      "consent": true
    },
    "response": {
      "case": "Case object"
    },
    "status": 201
  },
  "action": {
    "method": "POST",
    "path": "/cases/{id}/actions",
    "body": {
      "action": "message",
      "expected_version": 1,
      "text": "消息正文"
    },
    "response": {
      "case": "updated Case object"
    }
  },
  "upload": {
    "method": "POST",
    "path": "/cases/{id}/attachments",
    "content_type": "multipart/form-data",
    "fields": {
      "file": "binary",
      "expected_version": "1"
    },
    "response": {
      "case": "Case object"
    },
    "status": 201
  },
  "download": {
    "method": "GET",
    "path": "/cases/{id}/attachments/{attachment_id}",
    "response": "private authorized binary"
  },
  "case_shape": {
