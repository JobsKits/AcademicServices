{
  "version": "1.1.0",
  "base_path": "/api/v1",
  "rules": [
    "Bearer session token",
    "Idempotency-Key required for mutations except login",
    "expected_version required for case actions",
    "money is integer CNY fen",
    "timestamps RFC3339 UTC",
    "401/403/409/422 never become demo successes",
    "network/5xx fallback to isolated local demo; unknown real writes retain original key and reconcile by reload; never replay demo writes",
    "Success is final 2xx; redirects are not success. File size limit 8 MiB. Production supports fixed admin/customer only in current MVP.",
    "Shop products and orders use current schema 2; shop writes require stable Idempotency-Key and optimistic expected_version for edits/actions.",
    "PAYMENT_MODE defaults to mock; real rejects pay until a verified gateway is implemented. No client-success assertion marks a real order paid."
  ],
  "login": {
    "method": "POST",
    "path": "/auth/login",
    "body": {
      "account": "customer",
      "password": "configured by environment"
    },
    "response": {
      "token": "opaque token",
      "user": {
        "id": "customer",
        "name": "客户",
        "role": "customer"
      }
    }
  },
  "services": {
    "method": "GET",
    "path": "/services",
    "response": {
      "services": [
        {
          "id": "graduation",
          "name": "毕业论文",
          "summary": "选题与写作辅导",
          "description": "服务范围以确认的报价为准",
          "active": true
        },
        {
          "id": "journal",
          "name": "普刊",
          "summary": "期刊咨询与稿件服务",
          "description": "服务范围以确认的报价为准",
          "active": true
        },
        {
          "id": "editing",
          "name": "编译",
          "summary": "学术翻译与语言润色",
          "description": "服务范围以确认的报价为准",
          "active": true
        }
      ]
    }
  },
  "workspace": {
    "method": "GET",
    "path": "/workspace",
    "response": {
      "user": {
        "id": "customer",
        "name": "客户",
        "role": "customer"
      },
      "services": [],
      "cases": []
    }
  },
  "create_case": {
    "method": "POST",
    "path": "/cases",
    "body": {
      "service_id": "graduation",
      "title": "示例需求",
      "description": "说明目标和现有材料",
      "discipline": "专业",
      "level": "本科",
      "word_count": 5000,
      "language": "中文",
      "deadline": "2026-12-01",
      "contact": "联系说明",
      "consent": true
    },
    "response": {
      "case": "Case object"
    },
    "status": 201
  },
  "action": {
    "method": "POST",
    "path": "/cases/{id}/actions",
    "body": {
      "action": "message",
      "expected_version": 1,
      "text": "消息正文"
    },
    "response": {
      "case": "updated Case object"
    }
  },
  "upload": {
    "method": "POST",
    "path": "/cases/{id}/attachments",
    "content_type": "multipart/form-data",
    "fields": {
      "file": "binary",
      "expected_version": "1"
    },
    "response": {
      "case": "Case object"
    },
    "status": 201
  },
  "download": {
    "method": "GET",
    "path": "/cases/{id}/attachments/{attachment_id}",
    "response": "private authorized binary"
  },
  "case_shape": {
    "id": "UUID",
    "owner_id": "customer",
    "service_id": "graduation",
    "title": "需求标题",
    "description": "内容",
    "discipline": "专业",
    "level": "本科",
    "word_count": 5000,
    "language": "中文",
    "deadline": "2026-12-01",
    "contact": "联系方式",
    "status": "pending_review",
    "version": 1,
    "created_at": "RFC3339",
    "updated_at": "RFC3339",
    "quote": null,
    "order": null,
    "attachments": [],
    "messages": [],
    "events": [],
    "after_sales": []
  },
  "quote_shape": {
    "id": "UUID",
    "amount_minor": 100000,
    "prepay_minor": 0,
    "currency": "CNY",
    "scope": "服务与交付约定",
    "expires_at": "RFC3339",
    "revision_limit": 2,
    "status": "offered"
  },
  "order_shape": {
    "id": "UUID",
    "status": "pending_start",
    "amount_minor": 100000,
    "original_amount_minor": 100000,
    "prepay_minor": 0,
    "paid_minor": 0,
    "refunded_minor": 0,
    "refund_held_minor": 0,
    "revision_used": 0,
    "revision_limit": 2,
    "paused": false,
    "holds": [],
    "deliveries": [],
    "payments": [],
    "refunds": []
  },
  "actions": {
    "need_material": {
      "role": "admin",
      "fields": [
        "text"
      ]
    },
    "supplement": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "quote": {
      "role": "admin",
      "fields": [
        "amount_minor",
        "prepay_minor",
        "scope",
        "expires_at",
        "revision_limit"
      ]
    },
    "withdraw_quote": {
      "role": "admin",
      "fields": [
        "text"
      ]
    },
    "accept_quote": {
      "role": "customer",
      "fields": [
        "quote_id"
      ]
    },
    "decline_quote": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "record_payment": {
      "role": "admin",
      "fields": [
        "amount_minor",
        "reference"
      ]
    },
    "start": {
      "role": "admin",
      "fields": []
    },
    "pause": {
      "role": "admin",
      "fields": [
        "text",
        "hold_id"
      ]
    },
    "resume": {
      "role": "admin",
      "fields": [
        "hold_id"
      ]
    },
    "deliver": {
      "role": "admin",
      "fields": [
        "text",
        "attachment_ids",
        "after_sale_id"
      ]
    },
    "revision": {
      "role": "customer",
      "fields": [
        "text",
        "delivery_id"
      ]
    },
    "accept_revision": {
      "role": "admin",
      "fields": [
        "feedback_id",
        "round_id",
        "count_units"
      ]
    },
    "accept_delivery": {
      "role": "customer",
      "fields": [
        "delivery_id"
      ]
    },
    "cancel": {
      "role": "admin",
      "fields": [
        "text",
        "settlement_minor"
      ]
    },
    "confirm_cancel": {
      "role": "customer",
      "fields": []
    },
    "refund": {
      "role": "admin",
      "fields": [
        "amount_minor",
        "payment_id"
      ],
      "note": "only creates requested; no money moved"
    },
    "after_sale": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "close_after_sale": {
      "role": "admin",
      "fields": [
        "after_sale_id",
        "text"
      ]
    },
    "message": {
      "role": "both",
      "fields": [
        "text"
      ]
    },
    "withdraw_request": {
      "role": "customer",
      "fields": [
        "text"
      ]
    },
    "approve_refund": {
      "role": "admin",
      "fields": [
        "refund_id"
      ]
    },
    "confirm_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "reference"
      ]
    },
    "mark_refund_unknown": {
      "role": "admin",
      "fields": [
        "refund_id"
      ]
    },
    "fail_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "text"
      ]
    },
    "reject_refund": {
      "role": "admin",
      "fields": [
        "refund_id",
        "text"
      ]
    },
    "resolve_refund_failed": {
      "role": "admin",
      "fields": [
        "refund_id",
        "reference",
        "text"
      ]
    },
    "reject_cancel": {
      "role": "customer",
      "fields": []
    },
    "propose_change": {
      "role": "admin",
      "fields": [
        "amount_minor",
        "scope",
        "deadline"
      ]
    },
    "confirm_change": {
      "role": "customer",
      "fields": [
        "change_id"
      ]
    },
    "reject_change": {
      "role": "customer",
      "fields": [
        "change_id"
      ]
    }
  },
  "error_shape": {
    "error": {
      "code": "version_conflict",
      "message": "请刷新后重试"
    }
  },
  "operation": {
    "method": "GET",
    "path": "/operations/{key}",
    "response": {
      "operation": {
        "status": "succeeded",
        "case_id": "UUID",
        "action": "message",
        "created_at": "RFC3339"
      },
      "case": "latest Case"
    },
    "note": "404 means no committed receipt now, not proof an in-flight write failed"
  },
  "detail": {
    "method": "GET",
    "path": "/cases/{id}",
    "response": {
      "case": "Case object"
    }
  },
  "logout": {
    "method": "POST",
    "path": "/auth/logout",
    "body": {},
    "response": {
      "ok": true
    }
  },
  "health": {
    "method": "GET",
    "path": "/health",
    "response": {
      "status": "ok",
      "version": "0.1.0"
    }
  },
  "shop": {
    "payment_mode": "mock",
    "product_shape": {
      "id": "stable string",
      "category_id": "graduation|journal|editing",
      "kind": "course|service",
      "name": "string",
      "summary": "string",
      "description": "string",
      "price_minor": "nonnegative integer CNY fen",
      "currency": "CNY",
      "image": "HTTPS, packaged relative path, raster image data URL, or empty",
      "sections": [
        {
          "title": "string",
          "body": "string"
        }
      ],
      "active": true,
      "in_stock": true,
      "version": 1,
      "is_demo": true,
      "reference_price": "reference-site fact; not operating price",
      "created_at": "RFC3339 UTC",
      "updated_at": "RFC3339 UTC"
    },
    "product_input": {
      "category_id": "graduation",
      "kind": "course",
      "name": "课程名称",
      "summary": "简介",
      "description": "详情",
      "price_minor": 100,
      "currency": "CNY",
      "image": "",
      "sections": [
        {
          "title": "交付",
          "body": "课程说明"
        }
      ],
      "active": true,
      "in_stock": true,
      "is_demo": true,
      "reference_price": "",
      "expected_version": 1
    },
    "order_shape": {
      "id": "UUID",
      "owner_id": "server authenticated user ID",
      "product_snapshot": "immutable Product",
      "quantity": 1,
      "amount_minor": "server Product price at purchase",
      "currency": "CNY",
      "status": "pending_payment|pending_completion|pending_review|completed|cancelled",
      "fulfillment_status": "pending|in_progress|delivered",
      "seller_status": "awaiting_payment|pending_delivery|in_progress|awaiting_confirmation|awaiting_review|completed|cancelled",
      "version": 1,
      "created_at": "RFC3339 UTC",
      "updated_at": "RFC3339 UTC",
      "paid_at": "RFC3339 UTC optional",
      "delivered_at": "RFC3339 UTC optional",
      "completed_at": "buyer acceptance time; optional",
      "delivery_text": "string",
      "payment": null,
      "review": null,
      "events": []
    },
    "payment_shape": {
      "id": "UUID",
      "mode": "mock",
      "channel": "alipay|wechat",
      "status": "succeeded",
      "amount_minor": "server order amount",
      "currency": "CNY",
      "reference": "MOCK-UUID; not provider transaction ID",
      "created_at": "RFC3339 UTC"
    },
    "review_shape": {
      "rating": "integer 1..5",
      "text": "nonblank string",
      "created_at": "RFC3339 UTC"
    },
    "endpoints": [
      {
        "method": "GET",
        "path": "/products?category_id=graduation",
        "auth": "public",
        "response": {
          "products": [
            "Product"
          ],
          "payment_mode": "mock|real"
        },
        "note": "Only active products; out-of-stock listings remain visible"
      },
      {
        "method": "GET",
        "path": "/products/{id}",
        "auth": "public",
        "response": {
          "product": "Product"
        }
      },
      {
        "method": "GET",
        "path": "/admin/products",
        "auth": "admin",
        "response": {
          "products": [
            "Product"
          ]
        }
      },
      {
        "method": "POST",
        "path": "/admin/products",
        "auth": "admin",
        "body": "product_input without required expected_version",
        "response": {
          "product": "Product"
        },
        "status": 201
      },
      {
        "method": "PUT",
        "path": "/admin/products/{id}",
        "auth": "admin",
        "body": "complete product_input including expected_version",
        "response": {
          "product": "Product"
        }
      },
      {
        "method": "POST",
        "path": "/shop-orders",
        "auth": "customer",
        "body": {
          "product_id": "Product.id",
          "product_version": 1
        },
        "response": {
          "order": "ShopOrder"
        },
        "status": 201
      },
      {
        "method": "GET",
        "path": "/shop-orders",
        "auth": "customer own/admin all",
        "response": {
          "orders": [
            "ShopOrder"
          ],
          "payment_mode": "mock|real"
        }
      },
      {
        "method": "GET",
        "path": "/shop-orders/{id}",
        "auth": "customer own/admin",
        "response": {
          "order": "ShopOrder"
        }
      },
      {
        "method": "POST",
        "path": "/shop-orders/{id}/actions",
        "auth": "action-dependent role and order owner",
        "body": {
          "action": "pay|start|deliver|accept|review|cancel",
          "expected_version": 1,
          "channel": "alipay|wechat; pay only",
          "text": "delivery/review text",
          "rating": "1..5 for review"
        },
        "response": {
          "order": "ShopOrder"
        }
      },
      {
        "method": "GET",
        "path": "/shop-operations/{key}",
        "auth": "current actor",
        "response": {
          "operation": {
            "status": "succeeded",
            "resource_type": "product|order",
            "resource_id": "UUID",
            "action": "string",
            "created_at": "RFC3339 UTC"
          },
          "order": "latest ShopOrder when resource_type=order",
          "product": "latest Product when resource_type=product"
        },
        "note": "404 is no committed receipt, not proof an in-flight request failed."
      }
    ],
    "actions": {
      "pay": {
        "role": "customer",
        "from": "pending_payment",
        "to": "pending_completion",
        "fields": [
          "channel"
        ],
        "note": "mock success; no real charge; channel validated"
      },
      "start": {
        "role": "admin",
        "from": "pending_completion/pending",
        "to": "pending_completion/in_progress"
      },
      "deliver": {
        "role": "admin",
        "from": "pending_completion and not delivered",
        "to": "pending_completion/delivered",
        "fields": [
          "text"
        ]
      },
      "accept": {
        "role": "customer",
        "from": "pending_completion/delivered",
        "to": "pending_review"
      },
      "review": {
        "role": "customer",
        "from": "pending_review",
        "to": "completed",
        "fields": [
          "text",
          "rating"
        ]
      },
      "cancel": {
        "role": "customer",
        "from": "pending_payment",
        "to": "cancelled"
      }
    },
    "consistency": "All shop writes atomically persist mutation, audit and receipt; replay receipt before version validation; same key different request returns 409; purchase checks current product version, active and in_stock; existing pending order pays its immutable snapshot."
  }
}
