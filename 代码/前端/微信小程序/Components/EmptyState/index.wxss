.empty-state { padding:56rpx 32rpx; text-align:center; border:1rpx solid var(--border,#ded3c5); border-radius:32rpx; background:var(--surface,#fffcf7); margin:28rpx 0; }
.empty-title { color:var(--text,#352a24); font-size:36rpx; font-weight:650; }.empty-description { margin:20rpx 0;color:var(--muted,#6f5b4e);font-size:30rpx;line-height:1.7; }
button { margin-top:28rpx;min-height:96rpx;padding:22rpx 28rpx;color:var(--text,#352a24);background:var(--soft,#f2ebe0);border-radius:24rpx;font-size:30rpx;white-space:normal; }button::after { border:0; }
