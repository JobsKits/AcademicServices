/* Created by Jobs. Warm, readable storefront in light and dark appearance. */
page{background:#fbf5ec;font-family:system-ui,-apple-system,sans-serif;font-size:30rpx}
.app{--bg:#fbf5ec;--surface:#fffdf9;--text:#35271f;--muted:#6f5b4d;--border:#ded1c3;--accent:#905737;--soft:#eee0d0;--danger:#923f2c;--hint:#f8e9cc;min-height:100vh;background:var(--bg);color:var(--text)}
.app.dark{--bg:#211b17;--surface:#302720;--text:#f5eadd;--muted:#cbb6a4;--border:#66503f;--accent:#bd885f;--soft:#49382b;--danger:#ffb7a3;--hint:#493b27}
.page{max-width:1100rpx;margin:auto;padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap}.nav{margin-bottom:28rpx}.nav-actions{display:flex;gap:12rpx}.wordmark{font-size:42rpx;font-weight:700;letter-spacing:6rpx}.hero-panel{position:relative;background:var(--soft);border-radius:30rpx;padding:38rpx 32rpx;overflow:hidden}.hero{font-size:64rpx;font-weight:700;line-height:1.35;letter-spacing:-1rpx;margin:16rpx 0;overflow-wrap:anywhere}.hero-panel .hero{max-width:75%}.hero-panel .sub{max-width:78%}.hero-brand{position:absolute;width:130rpx;height:130rpx;right:12rpx;bottom:20rpx;opacity:.65}.eyebrow{font-size:24rpx;color:var(--muted);letter-spacing:2rpx}.sub,.muted{color:var(--muted);font-size:28rpx;line-height:1.7}.small{font-size:24rpx}.categories,.channel-row{display:flex;gap:14rpx;margin:24rpx 0;flex-wrap:wrap}.categories button{flex:1;min-width:150rpx}.section,.title{font-size:34rpx;font-weight:650;line-height:1.45;overflow-wrap:anywhere}.section{margin:24rpx 0}.source{font-size:24rpx;color:var(--muted);margin:14rpx 0}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.product-card{background:var(--surface);border:1rpx solid var(--border);border-radius:24rpx;overflow:hidden}.product-image{position:relative;background:var(--soft);height:220rpx}.product-image image{width:100%;height:100%;padding:30rpx;box-sizing:border-box}.product-image .remote-image{position:absolute;inset:0;padding:0}.image-category{position:absolute;bottom:12rpx;left:12rpx;border-radius:10rpx;background:var(--surface);padding:4rpx 10rpx;font-size:22rpx}.product-body{padding:20rpx}.product-body .title{font-size:30rpx;margin-top:12rpx}.price{font-size:36rpx;color:var(--accent);font-weight:700;margin:14rpx 0}.price.large{font-size:54rpx}.badge{display:inline-block;background:var(--soft);color:var(--muted);padding:6rpx 14rpx;border-radius:12rpx;font-size:24rpx}.card{background:var(--surface);border:1rpx solid var(--border);border-radius:24rpx;padding:28rpx;margin:24rpx 0}.line{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.75;margin:18rpx 0}.product-title{font-size:46rpx}.detail-image{height:340rpx;border-radius:26rpx;margin:28rpx 0;overflow:hidden}.demo{padding:24rpx;background:var(--hint);border:1rpx solid var(--border);border-radius:16rpx;margin:20rpx 0;font-size:26rpx;line-height:1.7}.error{padding:22rpx;border:1rpx solid var(--danger);color:var(--danger);border-radius:16rpx;margin:20rpx 0;line-height:1.7}.stock{color:var(--danger);font-size:24rpx;margin-top:14rpx}button{background:var(--accent);color:#fff;border-radius:14rpx;font-size:28rpx;line-height:1.6;min-height:80rpx;padding:20rpx;margin:18rpx 0 0;overflow-wrap:anywhere;white-space:normal}button::after{border:0}button.secondary,button.category{color:var(--text);background:var(--soft)}button.selected{color:#fff;background:var(--accent)}button.small{font-size:24rpx;padding:14rpx 20rpx;min-height:66rpx;margin:0}button[disabled]{opacity:.5;background:var(--soft);color:var(--muted)}label{display:block;color:var(--muted);font-size:26rpx;margin-top:24rpx}input,textarea,.picker-value{box-sizing:border-box;border:1rpx solid var(--border);border-radius:14rpx;padding:20rpx;background:var(--surface);color:var(--text);font-size:28rpx;min-height:84rpx;width:100%;margin:12rpx 0}textarea{height:200rpx}.filter-list{display:flex;gap:14rpx;padding:16rpx 0;white-space:nowrap}.filter-list button{flex-shrink:0}.filters{width:100%}.mask{position:fixed;inset:0;background:rgba(20,13,8,.65);display:flex;align-items:flex-end;z-index:100}.cashier{width:100%;max-height:85vh;overflow-y:auto;box-sizing:border-box;background:var(--surface);border-radius:30rpx 30rpx 0 0;padding:36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}.channel-row button{flex:1;min-width:180rpx}
@media (min-width:700px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.cashier{max-width:700px;margin:auto;align-self:center;border-radius:28rpx}}
