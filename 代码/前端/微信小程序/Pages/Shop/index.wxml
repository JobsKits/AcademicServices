<view class="app {{theme}}"><view class="page tab-page">
  <view class="row nav"><view class="wordmark">知序</view><view class="nav-actions"><button wx:if="{{!user}}" class="small" bindtap="login">{{t.loginRegister}}</button><button wx:else class="small secondary account-entry" bindtap="profile"><view class="nav-avatar" style="background:{{user.avatar_color || '#905737'}}"><view>{{avatarText}}</view><image wx:if="{{avatarSource &amp;&amp; !failedImages.avatar}}" src="{{avatarSource}}" mode="aspectFill" data-id="avatar" binderror="imageError"/></view><text>{{user.name}}</text></button><button wx:if="{{user}}" class="small secondary" bindtap="orders">{{t.myOrders}}</button><button wx:if="{{!user}}" class="secondary settings-icon" bindtap="settings" aria-label="{{t.settings}}"><image class="line-icon" src="/Assets/Icons/settings.svg" mode="aspectFit" aria-hidden="{{true}}"/></button></view></view>
  <view class="banner-visibility" wx:if="{{banners.length>0}}">
    <view wx:if="{{banners.length===1}}" class="banner-static"><view class="banner-frame" data-id="{{banners[0].id}}" bindtap="banner"><image class="banner-brand" src="/Assets/brand.png" mode="aspectFit"/><image wx:if="{{banners[0].image &amp;&amp; !failedImages[banners[0].id]}}" class="banner-picture" src="{{banners[0].image}}" mode="aspectFit" data-id="{{banners[0].id}}" binderror="imageError"/><view class="banner-caption">{{t[banners[0].title] || banners[0].title}}</view></view></view>
    <swiper wx:elif="{{banners.length>1}}" class="banner-swiper" autoplay="{{carouselPlaying}}" circular="{{true}}" indicator-dots="{{false}}" current="{{bannerIndex}}" bindchange="bannerChanged" interval="{{carouselInterval}}" duration="{{carouselDuration}}" bindtouchstart="pauseGesture" bindtouchend="finishGesture" bindtouchcancel="finishGesture"><swiper-item wx:for="{{banners}}" wx:key="id"><view class="banner-frame" data-id="{{item.id}}" bindtap="banner"><image class="banner-brand" src="/Assets/brand.png" mode="aspectFit"/><image wx:if="{{item.image &amp;&amp; !failedImages[item.id]}}" class="banner-picture" src="{{item.image}}" mode="aspectFit" data-id="{{item.id}}" binderror="imageError"/><view class="banner-caption">{{t[item.title] || item.title}}</view></view></swiper-item></swiper>
  <view class="carousel-pagination" wx:if="{{banners.length>1}}"><button wx:for="{{banners}}" wx:key="id" class="carousel-dot" data-index="{{index}}" bindtap="selectBanner" aria-label="{{t.banners+' '+(index+1)}}" aria-current="{{bannerIndex===index}}"><view class="carousel-mark {{bannerIndex===index?'selected':''}}"/></button></view>
  </view>
  <view class="categories"><button wx:for="{{categories}}" wx:key="*this" class="category {{category===item?'selected':''}}" data-id="{{item}}" bindtap="category">{{t[item]}}</button></view>
  <view class="row"><view class="section">{{t[category]}}</view></view>
  <view class="source">{{source==='demo'?t.offline:source==='stale'?t.staleData:t.online}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <swiper class="goods-swiper" current="{{categoryIndex}}" bindchange="swipe" duration="250"><swiper-item wx:for="{{groups}}" wx:for-item="group" wx:key="id"><scroll-view scroll-y class="goods-panel"><empty-state wx:if="{{!group.products.length}}" title="{{t.emptyProducts}}" description="{{t.emptyHint}}" reload-label="{{t.reload}}" bind:reload="reload"/><view class="product-grid"><view wx:for="{{group.products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="product"><view class="product-image"><image src="/Assets/brand.png" mode="aspectFit"/><image wx:if="{{item.image &amp;&amp; !failedImages[item.id]}}" class="remote-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><view class="image-category">{{t[item.category_id]}}</view></view><view class="product-body"><view class="badge">{{t[item.kind]}}</view><view class="title">{{item.name}}</view><view class="sub small">{{item.summary}}</view><view class="price">{{item.amount}}</view><view class="small muted" wx:if="{{item.is_demo}}">{{t.demoGoods}}</view><view class="stock" wx:if="{{!item.in_stock}}">{{t.outOfStock}}</view><button size="mini">{{t.details}}</button></view></view></view></scroll-view></swiper-item></swiper>
</view></view>
