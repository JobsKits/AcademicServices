<view class="app {{theme}}"><view class="page tab-page" wx:if="{{user}}"><view class="hero product-title">{{t.mine}}</view><view class="card profile-card"><view class="avatar-frame" style="background:{{user.avatar_color || '#905737'}}"><view class="avatar-letter">{{avatarText}}</view><image wx:if="{{avatarSource &amp;&amp; !failedImages.avatar}}" class="remote-image" src="{{avatarSource}}" mode="aspectFill" data-id="avatar" binderror="imageError"/></view><view class="profile-copy"><view class="profile-name">{{user ? user.name : t.signInFirst}}</view><view class="sub">{{t.profileHint}}</view></view></view><view class="section" wx:if="{{user}}">{{t.myOrders}}</view><view class="order-shortcuts" wx:if="{{user}}"><button wx:for="{{states}}" wx:key="id" class="shortcut secondary" data-id="{{item.id}}" bindtap="orderStatus"><image class="line-icon" src="/Assets/Icons/{{item.icon}}.svg" mode="aspectFit"/><view>{{orderLabels[item.id] || t[item.id]}}</view><view wx:if="{{counts[item.id]}}" class="count">{{counts[item.id]}}</view></button></view><view wx:if="{{isSeller}}" class="demo">{{t.sellerReadOnly}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="secondary settings-icon" bindtap="settings" aria-label="{{t.settings}}"><image class="line-icon" src="/Assets/Icons/settings.svg" mode="aspectFit" aria-hidden="{{true}}"/></button></view></view>
