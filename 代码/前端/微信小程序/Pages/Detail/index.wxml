<view class="page"><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{c}}"><view class="demo" wx:if="{{source==='demo'}}">本地演示 · 不会同步真实业务</view><view class="badge">{{status}}</view><view class="hero">{{c.title}}</view><view class="sub line">{{c.description}}</view><view class="card" wx:if="{{c.quote}}"><view class="row"><text class="title">报价 {{quoteMoney}}</text><text>{{c.quote.currency}}</text></view><view class="line">{{c.quote.scope}}</view><view class="muted small line">有效期 {{c.quote.expires_at}} · 修改 {{c.quote.revision_limit}} 轮</view><block wx:if="{{c.quote.status==='offered'&&!c.order}}"><button data-action="accept_quote" data-quote="{{c.quote.id}}" bindtap="action" disabled="{{busy}}">确认报价与服务范围</button><button class="secondary" data-action="decline_quote" bindtap="action" disabled="{{busy}}">拒绝报价并关闭需求</button></block></view><view class="card" wx:if="{{c.order}}"><view class="title">订单进度</view><view class="sub line">净收款 {{paid}} · 已受理修改 {{c.order.revision_used}} / {{c.order.revision_limit}}</view><view wx:for="{{holds}}" wx:key="id" class="line">{{item.closed_at?'已恢复':'暂停'}}：{{item.reason}}</view><empty-state wx:if="{{!holds.length}}" title="暂无暂停记录" description="当前没有暂停原因，重新加载可查看最新进度。" bindreload="reload"/><block wx:if="{{c.order.cancellation.status==='offered'}}"><view class="line">取消结算金额（分）：{{c.order.cancellation.settlement_minor}}</view><button data-action="confirm_cancel" bindtap="action">同意取消与结算</button><button class="secondary" data-action="reject_cancel" bindtap="action">拒绝取消方案</button></block><view wx:for="{{changes}}" wx:key="id"><block wx:if="{{item.status==='offered'}}"><view class="line">服务变更：{{item.scope}} · 总额（分）{{item.amount_minor}}</view><button data-action="confirm_change" data-change="{{item.id}}" bindtap="action">接受变更</button><button class="secondary" data-action="reject_change" data-change="{{item.id}}" bindtap="action">拒绝变更</button></block></view><empty-state wx:if="{{!changes.length}}" title="暂无待确认变更" description="有新的服务范围或金额变更时，会在此等待确认。" bindreload="reload"/></view><view class="card" wx:for="{{deliveries}}" wx:key="id"><view class="title">{{item.after_sale_id?'售后':'主服务'}}交付 v{{item.version}}</view><view class="line">{{item.text}}</view><view wx:if="{{item.actionable}}"><button data-action="accept_delivery" data-delivery="{{item.id}}" bindtap="action" disabled="{{busy}}">确认此版交付</button><button class="secondary" data-action="revision" data-delivery="{{item.id}}" bindtap="action" disabled="{{busy}}">按下方说明申请修改</button></view></view><view class="card" wx:if="{{!deliveries.length}}"><empty-state title="暂无交付记录" description="运营发布交付后，可在此查看内容并反馈或验收。" bindreload="reload"/></view><view class="section">材料与附件</view><view class="card"><view wx:for="{{attachments}}" wx:key="id" class="line link" data-id="{{item.id}}" bindtap="download">{{item.name}} · 点击预览/保存</view><empty-state wx:if="{{!attachments.length}}" title="暂无附件" description="可上传聊天文件补充材料，或重新加载查看已上传的文件。" bindreload="reload"/><button class="secondary" bindtap="upload">选择聊天文件上传</button></view><view class="section">沟通记录</view><view class="card"><view wx:for="{{messages}}" wx:key="id" class="line"><text class="small muted">{{item.author_name||item.author_id}}：</text>{{item.text}}</view><empty-state wx:if="{{!messages.length}}" title="暂无沟通记录" description="发送留言后可在此查看与运营的沟通。" bindreload="reload"/></view><textarea placeholder="补充说明、修改意见或售后原因" value="{{text}}" bindinput="input" maxlength="5000"/><button data-action="message" bindtap="action" disabled="{{busy}}">发送留言</button><button class="secondary" wx:if="{{c.status==='awaiting_material'}}" data-action="supplement" bindtap="action" disabled="{{busy}}">提交补充材料说明</button><button class="secondary" wx:if="{{c.order.status==='completed'||c.order.status==='cancelled'}}" data-action="after_sale" bindtap="action" disabled="{{busy}}">提出售后申请</button><button class="secondary" wx:if="{{!c.order&&c.status!=='closed'}}" data-action="withdraw_request" bindtap="action" disabled="{{busy}}">撤回需求</button></block><view class="card" wx:if="{{!c}}"><empty-state title="当前需求未加载" description="请检查账户权限与连接，重新加载取得最新记录。" bindreload="reload"/></view><button class="secondary" bindtap="reload">重新加载</button></view>
