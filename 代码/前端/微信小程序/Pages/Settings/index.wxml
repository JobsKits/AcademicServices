<view class="app {{theme}}"><view class="page"><view class="hero product-title">{{t.settings}}</view>
  <view class="card" wx:if="{{user}}"><view class="avatar-frame" style="background:{{user.avatar_color || '#905737'}}"><view class="avatar-letter">{{avatarText}}</view><image wx:if="{{avatarSource &amp;&amp; !failedImages.avatar}}" class="remote-image" src="{{avatarSource}}" mode="aspectFill" data-id="avatar" binderror="imageError"/></view><button disabled="{{busy}}" loading="{{busy}}" bindtap="avatar">{{t.uploadAvatar}}</button><view class="sub small">{{t.avatarHint}}</view><label>{{t.username}}</label><input maxlength="32" value="{{username}}" data-field="username" bindinput="input"/><button disabled="{{busy}}" bindtap="saveProfile">{{t.save}}</button></view>
  <label>{{t.language}}</label><picker range="{{languages}}" value="{{languageIndex}}" bindchange="language"><view class="picker-value">{{languages[languageIndex]}}</view></picker>
  <label>{{t.theme}}</label><picker range="{{themes}}" value="{{themeIndex}}" bindchange="theme"><view class="picker-value">{{themes[themeIndex]}}</view></picker>
  <view class="card"><view class="row"><label>{{t.carouselAutoplay}}</label><switch checked="{{carouselEnabled}}" color="#905737" bindchange="autoplay"/></view><label>{{t.carouselInterval}}</label><picker range="{{intervalLabels}}" value="{{intervalIndex}}" bindchange="interval"><view class="picker-value">{{intervalLabels[intervalIndex]}} {{t.seconds}}</view></picker><view class="row"><label>{{t.reduceMotion}}</label><switch checked="{{reduceMotion}}" color="#905737" bindchange="motion"/></view></view>
  <view class="card" wx:if="{{demoMode}}"><label>{{t.api}}</label><input value="{{base}}" data-field="base" bindinput="input"/><label>{{t.timeout}}</label><input type="number" value="{{timeoutMs}}" data-field="timeoutMs" bindinput="input"/><button bindtap="save">{{t.save}}</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><button class="secondary" wx:if="{{user}}" bindtap="logout">{{t.logout}}</button>
</view></view>
