<view class="app {{theme}}"><view class="page"><view class="hero product-title">{{t.settings}}</view>
  <label>{{t.language}}</label><picker range="{{languages}}" value="{{languageIndex}}" bindchange="language"><view class="picker-value">{{languages[languageIndex]}}</view></picker>
  <label>{{t.theme}}</label><picker range="{{themes}}" value="{{themeIndex}}" bindchange="theme"><view class="picker-value">{{themes[themeIndex]}}</view></picker>
  <view class="card"><label>{{t.api}}</label><input value="{{base}}" data-field="base" bindinput="input"/><label>{{t.timeout}}</label><input type="number" value="{{timeoutMs}}" data-field="timeoutMs" bindinput="input"/><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="save">{{t.save}}</button></view>
  <button class="secondary" bindtap="login">{{t.account}}</button><button class="secondary" bindtap="shop">{{t.shop}}</button>
</view></view>
