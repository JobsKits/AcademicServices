<view class="app {{theme}}"><view class="page"><view class="hero product-title">{{t.loginRegister}}</view>
  <view class="auth-tabs"><button class="small {{authMode==='login'?'selected':'secondary'}}" data-mode="login" bindtap="mode">{{t.login}}</button><button class="small {{authMode==='register'?'selected':'secondary'}}" data-mode="register" bindtap="mode">{{t.register}}</button><button class="small {{authMode==='reset'?'selected':'secondary'}}" data-mode="reset" bindtap="mode">{{t.forgotPassword}}</button></view>
  <view class="card">
    <block wx:if="{{authMode==='login'}}"><label>{{t.loginAccount}}</label><input value="{{account}}" data-field="account" bindinput="input"/></block>
    <block wx:else><label>{{t.email}}</label><input type="text" value="{{email}}" data-field="email" bindinput="input"/><label>{{t.emailCode}}</label><input type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="input"/><button class="secondary" disabled="{{sendingCode || cooldown>0}}" loading="{{sendingCode}}" bindtap="sendCode">{{cooldown>0 ? cooldown+'s' : t.sendCode}}</button><block wx:if="{{authMode==='register'}}"><label>{{t.username}}</label><input maxlength="32" value="{{username}}" data-field="username" bindinput="input"/></block></block>
    <label>{{t.password}}</label><input password="{{true}}" value="{{password}}" data-field="password" bindinput="input"/>
    <block wx:if="{{authMode!=='login'}}"><label>{{t.confirmPassword}}</label><input password="{{true}}" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input"/><view class="sub small">{{t.passwordRules}}</view></block>
    <view class="demo" wx:if="{{notice}}">{{notice}}</view><view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="auth-submit" disabled="{{busy}}" loading="{{busy}}" bindtap="submit">{{authMode==='login'?t.login:authMode==='register'?t.register:t.resetPassword}}</button>
  </view>
  <view wx:if="{{demoMode}}" class="demo"><view class="title">{{t.demoMode}}</view><view class="sub small">{{t.demoConfiguredHint}}</view><view wx:for="{{credentials}}" wx:key="role" class="card"><view class="credential-line" data-index="{{index}}" data-field="role" bindtap="copyCredential"><text class="muted">{{t.role}}</text><text>{{item.role==='admin'?t.administrator:t.customer}} · {{t.copy}}</text></view><view class="credential-line" data-index="{{index}}" data-field="account" bindtap="copyCredential"><text class="muted">{{t.account}}</text><text>{{item.account}} · {{t.copy}}</text></view><view class="credential-line" data-index="{{index}}" data-field="password" bindtap="copyCredential"><text class="muted">{{t.password}}</text><text>{{item.password}} · {{t.copy}}</text></view></view></view>
</view></view>
