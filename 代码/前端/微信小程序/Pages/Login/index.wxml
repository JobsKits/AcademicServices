<view class="app {{theme}}"><view class="page"><view class="hero product-title">{{t.account}}</view><view class="sub">{{t.loginHint}}</view><view class="card"><label>{{t.account}}</label><input value="{{account}}" data-field="account" bindinput="input"/><label>{{t.password}}</label><input password="{{true}}" value="{{password}}" data-field="password" bindinput="input"/><view class="error" wx:if="{{error}}">{{error}}</view><button disabled="{{busy}}" loading="{{busy}}" bindtap="submit">{{t.login}}</button><button disabled="{{busy}}" class="secondary" bindtap="demo">{{t.offline}}</button></view><button class="secondary" bindtap="settings">{{t.settings}}</button><button class="secondary" bindtap="logout">{{t.logout}}</button><button class="secondary" bindtap="shop">{{t.shop}}</button></view></view>
